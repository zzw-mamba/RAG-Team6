{
  "model": {
    "backend": "hf", "model": "meta-llama/Llama-3.1-8B-Instruct",
    "device_map": "cuda:0", "dtype": "bfloat16", "load_in_4bit": true
  },
  "lora": {
    "r": 16, "lora_alpha": 32, "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"]
  },
  "max_seq_length": 8192,
  "training": {
    "output_dir": "checkpoints/critic-sft", "num_train_epochs": 1,
    "per_device_train_batch_size": 1, "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 8, "learning_rate": 0.0002,
    "bf16": true, "gradient_checkpointing": true,
    "logging_steps": 10, "save_steps": 100, "save_total_limit": 2,
    "optim": "adamw_torch", "report_to": "none", "seed": 42,
    "remove_unused_columns": false
  }
}
